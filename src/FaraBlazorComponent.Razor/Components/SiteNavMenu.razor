@* サイドバーの項目（MudBlazor の MudNavMenu）。項目と見出しはサイトが渡す（SiteNavGroup）。現在のページの項目は、MudNavLink が active にする。
   Top には、サイドバーの一番上に置く内容（スマホの全ページ共通の設定など）を渡せる。
   項目は <a href> のまま（OnClick を付けると、MudBlazor が href の無い要素にするため）。スマホでメニューを閉じるのは、SiteLayout が画面の移動で行う。
   サイドバーの折りたたみ（PC の細い列）は SiteLayout の Mini ドロワーが行う *@
@inject NavigationManager Nav

<MudNavMenu Class="fbc-nav">
    @if (Top is not null)
    {
        @Top
    }
    @foreach (var group in Groups)
    {
        @if (!string.IsNullOrEmpty(group.Title))
        {
            <div class="fbc-nav-section">@group.Title</div>
        }
        @foreach (var item in group.Items)
        {
            @if (item.Disabled)
            {
                @* 選べない項目（未対応のゲームなど）。押しても何も起きず、メニューも閉じない *@
                <MudNavLink Disabled="true" Icon="@item.Icon" title="@item.Title" aria-disabled="true">@item.Label</MudNavLink>
            }
            else
            {
                <MudNavLink Href="@item.Href" Match="@MatchFor(item)" Icon="@item.Icon" title="@item.Title">@item.Label</MudNavLink>
            }
        }
    }
</MudNavMenu>

@code {
    /// <summary>見出しと項目の並び。</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SiteNavGroup> Groups { get; set; } = Array.Empty<SiteNavGroup>();

    /// <summary>メニューの一番上に置く内容（省略可）。</summary>
    [Parameter] public RenderFragment? Top { get; set; }

    /// <summary>
    /// 現在のページかどうかの判定。項目の Href が空（ホーム）は、そのページにいるときだけ active。
    /// それ以外は、Href で始まるページ（下位のページも含む）で active。
    /// </summary>
    private static NavLinkMatch MatchFor(SiteNavItem item) =>
        item.Href.Trim('/').Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
