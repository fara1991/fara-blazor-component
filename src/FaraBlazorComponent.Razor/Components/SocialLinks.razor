@* フッターの SNS のアイコン。出すサービスと URL は SiteOptions.Social で決める（URL が空のものは出さない）。
   名前・色・アイコンは kit が持つ（SocialServices）。サービスの色は、リンクの --brand に入る（CSS で地色にする） *@
@inject SiteOptions Site

@foreach (var social in Site.VisibleSocial.Where(s => IsSafeUrl(s.Url)))
{
    var service = SocialServices.Find(social.Service);
    <a class="fbc-footer-social fbc-service-@social.Service" href="@social.Url" target="_blank" rel="noopener noreferrer"
       aria-label="@service.Label" title="@service.Label" style="--brand: @service.Color">
        <SocialIcon Name="@social.Service" Size="13" />
    </a>
}

@code {
    /// <summary>
    /// リンクに使ってよい URL か。https:// の絶対 URL だけ（javascript: や data: や http: は出さない。サイトが誤って入れても、描画しない）。
    /// </summary>
    public static bool IsSafeUrl(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri)
        && uri.Scheme == Uri.UriSchemeHttps
        && !string.IsNullOrEmpty(uri.Host);
}
