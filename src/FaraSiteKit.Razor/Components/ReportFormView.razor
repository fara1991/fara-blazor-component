@* 「作者へ報告」（問い合わせ）の画面。送信は SiteOptions.ReportApiPath へ JSON で POST する（worker/report.js）。
   ボット判定は Cloudflare Turnstile（wwwroot/js/report.js）。受け付けていない（確認の鍵が無い）ときは、送信を止めて案内を出す。
   noindex（検索に出さない）は HeadContent で出す（HeadOutlet が必要。App の中に置く）。
   サイトの報告のページは、このコンポーネントを置くだけでよい（ページのパスは From に渡す） *@
@using System.Text
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject SiteOptions Site

@if (NoIndex)
{
    <HeadContent><meta name="robots" content="noindex" /></HeadContent>
}
<PageTitle>@Title | @Site.Name</PageTitle>

<div class="fsk-page-header fsk-page-column">
    <h3>@Title</h3>
    <p class="fsk-muted fsk-mb-0">@Lead</p>
</div>

@* PC: 見出しは固定にして、カードの中だけがスクロールする *@
<div class="fsk-pane-scroll fsk-page-pane">
<MudCard Elevation="0" Class="fsk-card fsk-mb-3 fsk-report-card fsk-page-card">
    <MudCardContent Class="fsk-card-body">
        @if (sent)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" NoIcon="true">送信しました。ありがとうございます。返信が必要な場合は、書いていただいた連絡先にお返事することがあります。</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="fsk-mt-3" OnClick="StartOver">もう 1 件送る</MudButton>
        }
        else
        {
            @if (disabled)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" NoIcon="true" Class="fsk-mb-3">いまは報告を受け付けていません。@UnavailableNote</MudAlert>
            }
            <div class="fsk-form-group fsk-mb-3">
                <label class="fsk-form-label" for="report-category">種類</label>
                <MudSelect T="string" Value="@Form.Category" ValueChanged="@(v => Form.Category = v ?? "")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="fsk-select" InputId="report-category" Placeholder="選んでください">
                    @foreach (var (id, label) in ReportForm.Categories)
                    {
                        <MudSelectItem T="string" Value="@id">@label</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="fsk-form-group fsk-mb-3">
                <label class="fsk-form-label" for="report-message">内容 <small class="fsk-muted">（@ReportForm.MinMessage〜@ReportForm.MaxMessage 文字。いま @ReportForm.CountCharacters(Form.Message.Trim()) 文字）</small></label>
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="fsk-field" InputId="report-message" Lines="6" MaxLength="@ReportForm.MaxMessage" Immediate="true"
                              Value="@Form.Message" ValueChanged="@(v => Form.Message = v ?? "")" Placeholder="@MessagePlaceholder" />
            </div>
            <div class="fsk-form-group fsk-mb-3">
                <label class="fsk-form-label" for="report-contact">@ContactLabelText</label>
                <p class="fsk-small fsk-muted fsk-mb-1">@ContactHintText</p>
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="fsk-field" InputId="report-contact" MaxLength="@ReportForm.MaxContact"
                              Value="@Form.Contact" ValueChanged="@(v => Form.Contact = v ?? "")" Placeholder="@ContactPlaceholderText" />
            </div>
            @* ボット対策の罠。人には見えない（CSS で画面の外に出す、.report-trap）。入っていたら、サーバーは何も送らずに成功を返す *@
            <div class="fsk-report-trap" aria-hidden="true">
                <label>ウェブサイト <input type="text" tabindex="-1" autocomplete="off" @bind="Form.Website" /></label>
            </div>
            <div id="@TurnstileId" class="fsk-mb-3"></div>
            @if (!string.IsNullOrEmpty(error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" NoIcon="true" Class="fsk-mb-3" role="alert">@error</MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync" Disabled="@(sending || disabled)">@(sending ? "送信中…" : "送信する")</MudButton>
            <p class="fsk-small fsk-muted fsk-mt-3 fsk-mb-0">送信すると、<a href="@Site.PrivacyPath">プライバシーポリシー</a>に書いたとおり、内容が作者に通知されます。個人情報（パスワード・アクセスキーなど）は書かないでください。</p>
        }
    </MudCardContent>
</MudCard>
</div>

@code {
    /// <summary>画面の題名（見出しと、ページの題名に使う）。</summary>
    [Parameter] public string Title { get; set; } = "問い合わせ";

    /// <summary>見出しの下の説明。</summary>
    [Parameter] public string Lead { get; set; } = "不具合・要望・ご意見を、作者に直接送れます。いただいた内容は、作者に通知されます（公開はされません）。";

    /// <summary>報告のきっかけになったページのパス（省略可。送り先に一緒に送る。安全な形でなければ送らない）。</summary>
    [Parameter] public string? From { get; set; }

    /// <summary>検索に出さない（noindex）か。既定は出さない。</summary>
    [Parameter] public bool NoIndex { get; set; } = true;

    /// <summary>受け付けていないときの案内の続き（例: 「お急ぎの場合は、フッターの Twitter からお願いします。」）。</summary>
    [Parameter] public string UnavailableNote { get; set; } = "";

    /// <summary>内容の欄の例文。</summary>
    [Parameter] public string MessagePlaceholder { get; set; } = "例: 〇〇の画面で、結果が出ません（操作の手順も書いてもらえると助かります）";

    /// <summary>連絡先の欄の説明。未指定なら、任意のときは「返信が欲しいときだけ…」、必須のときは「返信先として…」。</summary>
    [Parameter] public string? ContactHint { get; set; }

    /// <summary>連絡先を必須にするか。既定は任意（従来どおり）。必須のときは、空のままでは送れない。</summary>
    [Parameter] public bool ContactRequired { get; set; }

    /// <summary>連絡先の形の検査。既定は <see cref="ReportContactFormat.Any"/>。<see cref="ReportContactFormat.XHandle"/> は X のユーザー名（@ + 英数字とアンダースコア 1〜15 文字）。</summary>
    [Parameter] public ReportContactFormat ContactFormat { get; set; } = ReportContactFormat.Any;

    /// <summary>連絡先の欄の見出し（例: 「X のユーザー名（@○○）」）。未指定は「連絡先」。末尾に「（必須）」か「（任意）」を付ける。エラー文の呼び名にも使う。</summary>
    [Parameter] public string? ContactLabel { get; set; }

    /// <summary>連絡先の欄の例。未指定なら、任意のときは「返信が必要なときだけ」、必須のときは「返信先」。</summary>
    [Parameter] public string? ContactPlaceholder { get; set; }

    /// <summary>送信の待ち時間の上限（これを過ぎたら、通信できなかったものとして案内する）。</summary>
    [Parameter] public TimeSpan Timeout { get; set; } = TimeSpan.FromSeconds(15);

    private const string TurnstileId = "fsk-report-turnstile";

    /// <summary>入力の内容（テストからも見る）。</summary>
    internal ReportForm Form { get; set; } = new();

    private string ContactLabelText => (ContactLabel ?? "連絡先") + (ContactRequired ? "（必須）" : "（任意）");

    private string ContactHintText => ContactHint ?? (ContactRequired
        ? "返信先として、連絡のつくメールアドレスや SNS の ID などを書いてください。"
        : "返信が欲しいときだけ、メールアドレスや SNS の ID などを書いてください。書かなくても送れます。");

    private string ContactPlaceholderText => ContactPlaceholder ?? (ContactRequired ? "返信先" : "返信が必要なときだけ");

    /// <summary>パラメーターの連絡先の規則を、入力の検査（ReportForm）に反映する。</summary>
    private void ApplyContactRules()
    {
        Form.ContactRequired = ContactRequired;
        Form.ContactFormat = ContactFormat;
        Form.ContactName = ContactLabel is { Length: > 0 } label ? label : "連絡先";
    }

    protected override void OnParametersSet() => ApplyContactRules();

    private bool sent;
    private bool sending;
    private bool disabled;
    private bool mounted;
    private string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 送信後に「もう 1 件送る」で戻ったときも、確認の欄を作り直す
        if (sent || mounted) return;
        try
        {
            mounted = true;
            var enabled = await JS.InvokeAsync<bool>("faraSiteKit.report.mount", TurnstileId, Site.ReportConfigPath);
            if (!enabled)
            {
                disabled = true;
                StateHasChanged();
            }
        }
        catch
        {
            // JS が使えない・確認の部品を読み込めないとき。mounted は戻さない（戻すと、描画のたびに読み込みを繰り返してしまう）
            disabled = true;
            StateHasChanged();
        }
    }

    private async Task SendAsync()
    {
        if (sending) return;
        error = "";
        Form.Page = ReportForm.CleanPage(From);
        // 確認以外の入力を先に確かめる（確認を待たずに、入力の間違いを知らせる）
        Form.TurnstileToken = "pending";
        if (Form.Validate() is { } problem)
        {
            Form.TurnstileToken = "";
            error = problem;
            return;
        }
        sending = true;
        try
        {
            // 確認のトークンは、読み込み直後や、送信に失敗して作り直した直後は、数秒かかることがある。待ってから送る
            try { Form.TurnstileToken = await JS.InvokeAsync<string>("faraSiteKit.report.waitToken", 5000) ?? ""; }
            catch { Form.TurnstileToken = ""; }
            if (Form.Validate() is { } notChecked)
            {
                error = notChecked;
                return;
            }
            using var cts = new CancellationTokenSource(Timeout);
            using var request = new HttpRequestMessage(HttpMethod.Post, Site.ReportApiPath)
            {
                Content = new StringContent(Form.ToJson(), Encoding.UTF8, "application/json"),
            };
            using var response = await Http.SendAsync(request, cts.Token);
            var body = await response.Content.ReadAsStringAsync(cts.Token);
            if (response.IsSuccessStatusCode)
            {
                sent = true;
                mounted = false;
                await SafeJsAsync("faraSiteKit.report.dispose");
                return;
            }
            error = ReportForm.DescribeFailure((int)response.StatusCode, body);
            await SafeJsAsync("faraSiteKit.report.reset");   // 確認は 1 回で使い切りなので、やり直せるように作り直す
        }
        catch (OperationCanceledException)
        {
            // 時間切れ（TaskCanceledException を含む）。ここで止めないと、エラーの画面が出ずに固まったように見える
            error = "時間がかかりすぎました。通信の状態を確かめて、もう一度お試しください";
            await SafeJsAsync("faraSiteKit.report.reset");
        }
        catch (HttpRequestException)
        {
            error = "通信できませんでした。通信の状態を確かめて、もう一度お試しください";
            await SafeJsAsync("faraSiteKit.report.reset");
        }
        finally
        {
            sending = false;
        }
    }

    private async Task SafeJsAsync(string identifier)
    {
        try { await JS.InvokeVoidAsync(identifier); }
        catch { /* 確認の部品が無いとき（JS が使えない）は、何もしない */ }
    }

    private void StartOver()
    {
        Form = new ReportForm();
        ApplyContactRules();
        sent = false;
        error = "";
        mounted = false;
    }

    public async ValueTask DisposeAsync()
    {
        await SafeJsAsync("faraSiteKit.report.dispose");
    }
}
