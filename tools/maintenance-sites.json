{
  "_comment": "一括変更 CLI（tools/maintenance.mjs）の対象。repo は GitHub のリポジトリ、workflows は env（dev / production）ごとの deploy ワークフローのファイル名と ref（dev = develop ブランチ、production = master）。workers は status で読む Worker 名（各サイトの wrangler.jsonc / wrangler.toml の name と同じ）。album（fara-vrc-photo-album）は載せていない: 公開を GitHub Actions では行わなくなった（2026-10-28。手元のアプリから公開する）ので、起動するワークフローが無い。",
  "sites": [
    {
      "name": "pokemon",
      "repo": "fara1991/fara-pokemon-battle-assistant",
      "workflows": {
        "dev": { "file": "deploy-develop.yml", "ref": "develop" },
        "production": { "file": "deploy.yml", "ref": "master" }
      },
      "workers": { "production": "fara-pokemon", "dev": "fara-pokemon-dev" }
    },
    {
      "name": "avatar",
      "repo": "fara1991/fara-avatar-modding-guide",
      "workflows": {
        "dev": { "file": "deploy.yml", "ref": "develop" },
        "production": { "file": "deploy.yml", "ref": "master" }
      },
      "workers": { "production": "fara-avatar", "dev": "fara-avatar-dev" }
    },
    {
      "name": "bot",
      "repo": "fara1991/fara-bot-moderator",
      "workflows": {
        "dev": { "file": "site.yml", "ref": "develop" },
        "production": { "file": "site.yml", "ref": "master" }
      },
      "workers": { "production": "fara-twitch-bot", "dev": "fara-twitch-bot-dev" }
    },
    {
      "name": "portfolio",
      "repo": "fara1991/fara-portfolio-site",
      "workflows": {
        "dev": { "file": "deploy-develop.yml", "ref": "develop" },
        "production": { "file": "deploy.yml", "ref": "master" }
      },
      "workers": { "production": "fara-portfolio", "dev": "fara-portfolio-dev" }
    }
  ]
}
