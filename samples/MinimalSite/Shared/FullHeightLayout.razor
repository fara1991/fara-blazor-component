@inherits LayoutComponentBase
@inject MaintenanceInfo Maintenance

@* FullHeight の例（album 向け）。PC はサイドバーが画面の最上部から全高になり、ヘッダーはその右だけ。スマホは従来どおり *@
<SiteLayout Body="@Body" Maintenance="Maintenance" DrawerClipMode="SiteDrawerClipMode.FullHeight" MobilePageScroll="true">
    <DrawerContent>
        <SiteNavMenu Groups="NavGroups" />
    </DrawerContent>
    <HeaderEnd>
        <ThemeSwitch />
    </HeaderEnd>
</SiteLayout>

@code {
    private static readonly IReadOnlyList<SiteNavGroup> NavGroups = new[]
    {
        new SiteNavGroup(null, new[]
        {
            new SiteNavItem("full", "ホーム", Icons.Material.Filled.Home, Exact: true),
            new SiteNavItem("full/worlds", "ワールド", Icons.Material.Filled.Public),
            new SiteNavItem("full/outfits", "服", Icons.Material.Filled.Checkroom),
        }),
        new SiteNavGroup("サポート", new[]
        {
            new SiteNavItem("report", "問い合わせ", Icons.Material.Filled.MailOutline),
            new SiteNavItem("privacy", "プライバシーポリシー", Icons.Material.Filled.PrivacyTip),
        }),
    };
}
