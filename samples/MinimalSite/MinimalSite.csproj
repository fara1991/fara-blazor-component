<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- kit の Razor 部品を使う最小のサイト（CI のビルドで壊れないことを確かめる。公開はしない） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MinimalSite</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FaraSiteKit.Razor\FaraSiteKit.Razor.csproj" />
  </ItemGroup>

</Project>
